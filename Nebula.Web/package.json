{
  "name": "nebula-web",
  "version": "0.0.0",
  "config": {
    "template_dir": "../Build/typescript-angular",
    "output_dir": "src/app/shared/generated",
    "swagger_json_path": "../Nebula.API/swagger.json"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve --disable-host-check true --ssl --ssl-cert server.crt --ssl-key server.key",
    "build": "ng build",
    "build-dev": "ng build",
    "build-qa": "node --max_old_space_size=8000 ./node_modules/@angular/cli/bin/ng build --configuration=qa",
    "build-ci": "node --max_old_space_size=8000 ./node_modules/@angular/cli/bin/ng build --configuration=qa",
    "build-prod": "node --max_old_space_size=8000 ./node_modules/@angular/cli/bin/ng build --configuration=production",
    "test": "ng test",
    "lint": "ng lint",
    "lint-fix": "ng lint --fix",
    "e2e": "ng e2e",
    "clean-model": "node src/scripts/clean-model.js",
    "gen-model": "npm run clean-model %npm_package_config_output_dir% && npx @openapitools/openapi-generator-cli generate --additional-properties=modelPropertyNaming=original,fileNaming=kebab-case,useHttpClient=true,supportsES6=true,useRxJS6=true,genericModuleWithProviders=true,ngVersion=12.2.213 -i %npm_package_config_swagger_json_path% -g typescript-angular -o %npm_package_config_output_dir% -t %npm_package_config_template_dir%",
    "prestart": "powershell -Command \"nvm install $(Get-Content .nvmrc); nvm use $(Get-Content .nvmrc); if ((Test-Path server.crt) -eq $false -or (Test-Path server.key) -eq $false) { npm run create-dev-cert }; npm run trust-dev-cert\"",
    "create-dev-cert": "openssl req -newkey rsa:2048 -x509 -nodes -keyout server.key -new -out server.crt -config ./dev-cert.cnf -sha256 -days 3650",
    "trust-dev-cert": "powershell -Command \"Import-Certificate -FilePath server.crt -CertStoreLocation cert:\\LocalMachine\\Root\""
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.0.6",
    "@angular/common": "^22.0.6",
    "@angular/compiler": "^22.0.6",
    "@angular/core": "^22.0.6",
    "@angular/forms": "^22.0.6",
    "@angular/localize": "^22.0.6",
    "@angular/platform-browser": "^22.0.6",
    "@angular/platform-browser-dynamic": "^22.0.6",
    "@angular/router": "^22.0.6",
    "@auth0/auth0-angular": "^2.6.0",
    "@ng-bootstrap/ng-bootstrap": "^21.0.0",
    "@ng-select/ng-select": "^23.5.1",
    "@popperjs/core": "^2.11.8",
    "@tinymce/tinymce-angular": "^9.1.1",
    "ag-grid-angular": "^34.3.1",
    "ag-grid-community": "^34.3.1",
    "bootstrap": "^5.3.8",
    "color-scheme": "^1.0.1",
    "core-js": "^3.48.0",
    "esri-leaflet": "^3.0.19",
    "font-awesome": "^4.7.0",
    "google-palette": "^1.1.1",
    "iso8601-js-period": "^0.2.1",
    "jquery": "^3.7.1",
    "leaflet": "^1.9.4",
    "leaflet-gesture-handling": "^1.2.2",
    "leaflet-loading": "^0.1.24",
    "leaflet.fullscreen": "^2.1.0",
    "leaflet.snogylop": "^0.4.0",
    "luxon": "^3.7.2",
    "ngx-select-dropdown": "^3.3.2",
    "npm": "^11.8.0",
    "rxjs": "^7.8.2",
    "tinymce": "^8.3.2",
    "topojson-client": "^3.1.0",
    "vega": "^6.2.0",
    "vega-embed": "^7.1.0",
    "vega-lite": "^6.4.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.0.6",
    "@angular-eslint/builder": "^22.0.0",
    "@angular-eslint/eslint-plugin": "^22.0.0",
    "@angular-eslint/eslint-plugin-template": "^22.0.0",
    "@angular-eslint/schematics": "^22.0.0",
    "@angular-eslint/template-parser": "^22.0.0",
    "@angular/cli": "^22.0.6",
    "@angular/compiler-cli": "^22.0.6",
    "@angular/language-service": "^22.0.6",
    "@babel/compat-data": "~7.9.0",
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@openapitools/openapi-generator-cli": "^2.29.0",
    "@types/geojson": "^7946.0.16",
    "@types/jasmine": "~5.1.0",
    "@types/jasminewd2": "^2.0.13",
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.10.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@typescript-eslint/types": "^8.65.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-unused-imports": "^4.3.0",
    "jasmine-core": "~5.1.0",
    "jasmine-spec-reporter": "~7.0.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage-istanbul-reporter": "^3.0.3",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "ts-node": "~8.9.1",
    "tslib": "^2.8.1",
    "typescript": "~6.0.3",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "^22.0.0"
  }
}
