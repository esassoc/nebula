# =============================================================================
# Per-developer overrides — copy to `.developer.env` (gitignored)
# =============================================================================
# Loaded AFTER .env, so anything here wins. This is where real secrets and
# personal settings go; `.env` is committed and must stay secret-free.
#
#   cp .devcontainer/.developer.env.template .devcontainer/.developer.env
# =============================================================================

# --- Run with no Azure dependency -------------------------------------------
# Set empty to skip Key Vault entirely. Program.cs only calls AddAzureKeyVault
# when KeyVaultName is non-empty, so the app falls back to appsecrets.json via
# SECRET_PATH and needs neither `az login` nor network access to Azure.
# KeyVaultName=

# --- Auth0 (your tenant / SPA app) ------------------------------------------
# Public identifiers, but left out of .env so a fresh clone does not silently
# point at someone else's tenant.
# AUTH0_DOMAIN=
# AUTH0_CLIENT_ID=
# AUTH0_AUDIENCE=

# --- Lyra --------------------------------------------------------------------
# Point at a different Lyra instance, or leave the .env default. There is no
# local Lyra: the three analysis pages need a reachable deployed instance.
# WEB_LYRA_BASE_URL=https://swn-lyra-dev.azurewebsites.net

# --- Corporate TLS interception (Zscaler etc.) -------------------------------
# Set to 1 if post-create fails with certificate errors while installing
# packages. Disables certificate validation for those downloads ONLY.
# ALLOW_INSECURE_TLS=0

# --- Local ports -------------------------------------------------------------
# Override if 12160/12162/12167/12168 collide with something on your host.
# API_PORT=12160
# WEB_PORT=12162
# DB_PORT=12167
# GEOSERVER_PORT=12168
